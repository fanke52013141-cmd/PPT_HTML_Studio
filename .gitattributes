config/html_runtime_skills/*.md text eol=lf
config/html_runtime_skills.json text eol=lf
.gitattributes text eol=lf
# The reference catalog hashes source bytes and copies text assets verbatim.
html_engine/reference-library/**/*.json text eol=lf
html_engine/reference-library/**/*.md text eol=lf
html_engine/reference-library/**/*.html text eol=lf
html_engine/visual/catalog/*.json text eol=lf
html_engine/visual/course-structures.cjs text eol=lf
html_engine/visual/schema.json text eol=lf
html_engine/visual/effects/registry.json text eol=lf
html_engine/visual/layouts/*.json text eol=lf
html_engine/visual/templates/*.json text eol=lf
html_engine/visual/themes/*.json text eol=lf
docs/assets/code-art-references/catalog-v1/**/*.json text eol=lf
docs/assets/code-art-references/catalog-v1/**/*.md text eol=lf
# These sealed sources contain CRLF (some mixed with LF) in the Git blob.
# Preserve their existing hashes byte-for-byte rather than converting on checkout.
html_engine/reference-library/standard-library.html -text !eol
html_engine/visual/layouts/comparison-three-columns-v1.json -text !eol
html_engine/visual/layouts/wide-body-pair-v1.json -text !eol
html_engine/visual/templates/comparison-three-columns-v1.json -text !eol
html_engine/visual/templates/wide-body-pair-v1.json -text !eol
# Capacity fixtures pin scene bytes in their manifest across Windows checkouts.
checks/fixtures/capacity-baseline/*.json text eol=lf

# Frozen evaluation fixtures publish their dataset hashes; keep bytes stable.
checks/fixtures/feature-recognition-controlled-v0.2.0/*.json text eol=lf
checks/fixtures/overflow-crossing/*.json text eol=lf
checks/fixtures/overflow-crossing/*.cjs text eol=lf

# Editor manifests hash exact source, license and output bytes on every host.
editor_ui/** text eol=lf
# Archived upstream license hashes cover original bytes, including CRLF.
editor_ui/licenses/*.LICENSE -text
editor_ui/licenses/*.NOTICE -text
# Generated bundles/notices/manifests must retain the exact bytes hashed by build.mjs.
static/editor_ui/** -text
static/html_handoff_workbench.js text eol=lf
static/html_editor_canvas.js text eol=lf
static/html_editor_timeline_bridge.js text eol=lf
static/html_scene_editor.js text eol=lf
static/html_local_repair.js text eol=lf
static/html_scene_edit.css text eol=lf
static/index.html text eol=lf
