        "sourceBeats": [
          {
            "id": "beat-0",
            "spoken_text": "冷杯外的小水滴，并不是杯里的水漏出来了。",
            "spoken_text_sha256": "9d7bc09e85d9807a9a8368cba0ccf6e60d725d7fd4a050685d41602199fc067f"
          },
          {
            "id": "beat-1",
            "spoken_text": "空气中含有通常看不见的水蒸气。",
            "spoken_text_sha256": "63f0e9ddab0fd72a3b23bd371e9ad0221a30d78714e68a8b4486d024ba0d6d08"
          },
          {
            "id": "beat-2",
            "spoken_text": "水蒸气遇到冷杯表面，冷却并凝结成小水滴。",
            "spoken_text_sha256": "6d0d4b6b4e7209aec6c68a1ad4605fa42410b16a5f93a452b668fd92d10349fd"
          },
          {
            "id": "beat-3",
            "spoken_text": "从气态变成液态，这个过程叫凝结。",
            "spoken_text_sha256": "fc30cb9e51ac91d5b5bc663b2d2cc64a38d9e1c3381880a06736e5578396a6cd"
          },
          {
            "id": "beat-4",
            "spoken_text": "所以，冷杯外的水滴来自空气中的水蒸气。",
            "spoken_text_sha256": "d0d3f584018666cad43eb11e57226c17209bc506a169bed8351e55f1417cae90"
          }
        ]
      },
      "narration_beats": [
        {
