{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hps.visual.v1",
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "version",
        "id",
        "name",
        "themeRef",
        "layoutRef",
        "durationMs",
        "nodes",
        "motion",
        "beats",
        "source"
      ],
      "properties": {
        "format": {
          "const": "hps.visual.scene"
        },
        "version": {
          "const": "0.1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
