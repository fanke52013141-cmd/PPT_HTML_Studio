        "format": {
          "const": "hps.visual.layout"
        },
        "version": {
          "const": "0.1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "contentBottom", "subtitleHeight"],
          "properties": {
            "width": {
              "const": 1600
            },
            "height": {
              "const": 900
            },
            "contentBottom": {
              "const": 800
            },
            "subtitleHeight": {
              "const": 100
            }
          }
        },
        "slots": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 40,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["box", "maxLines", "align", "z"],
            "properties": {
              "box": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y", "width", "height"],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1600
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1600
                  },
                  "width": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 1600
                  },
                  "height": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 1600
                  }
                }
              },
              "maxLines": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "align": {
                "enum": ["left", "center", "right"]
              },
              "z": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              }
            }
          }
        }
      }
    },
    "assetRecords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "path", "sha256", "anchors", "source"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "version": {
            "const": "0.1.0"
          },
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_./-]+\\.png$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "anchors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "x", "y"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{0,63}$"
                },
                "x": {
                  "type": "integer",
                  "minimum": 0
                },
                "y": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
